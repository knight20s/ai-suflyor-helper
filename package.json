{
  "name": "suflyor",
  "version": "1.0.0",
  "private": true,
  "description": "Always-on-top overlay that listens to the other side of a call, transcribes it locally with Whisper and gets answers from Claude Code",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "26.18.0",
    "resedit": "3.1.1"
  },
  "productName": "Suflyor",
  "author": "Suflyor",
  "build": {
    "appId": "suflyor.overlay",
    "productName": "Suflyor",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "session.js",
      "package.json",
      "src/**/*",
      "assets/**/*",
      "!node_modules/@lydell/node-pty-linux-*/**",
      "!node_modules/@lydell/node-pty-darwin-*/**",
      "!node_modules/@lydell/node-pty-win32-arm64/**"
    ],
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Suflyor",
      "uninstallDisplayName": "Suflyor",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "artifactName": "Suflyor-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
